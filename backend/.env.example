# MongoDB — leave empty to use the in-memory store
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_DB=progressai

# OpenRouter — leave empty to use rule-based recommendations
OPENROUTER_API_KEY=
# Comma-separated chain of cheap paid models, tried in order
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash,z-ai/glm-5.3-flash,qwen/qwen3.8-flash
APP_URL=http://localhost:3000
